<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hadronmemory.team-health</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/hadron</string>
		<string>team</string>
		<string>health</string>
		<string>sweep</string>
		<string>--config</string>
		<string>/home/u/my hosts/host 100%.yaml</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/home/u/bin</string>
	</dict>
	<key>StartInterval</key>
	<integer>300</integer>
</dict>
</plist>
